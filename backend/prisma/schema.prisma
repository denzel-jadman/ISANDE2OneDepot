generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model Product {
  id                 Int                        @id @default(autoincrement())
  sku                String                     @unique @db.VarChar(64)
  name               String                     @db.VarChar(160)
  category           String?                    @db.VarChar(120)
  price              Decimal                    @db.Decimal(12, 2)
  photoPath          String?                    @db.VarChar(255)
  quantity           Int                        @default(0)
  lowStockAt         Int                        @default(5)
  version            Int                        @default(0)
  archivedAt         DateTime?
  supplierId         Int?
  supplier           Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements          StockMovement[]
  orderItems         PurchaseOrderItem[]
  restockNotes       RestockNote[]
  customerOrderItems CustomerOrderRequestItem[]
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(160)
  email          String?         @db.VarChar(254)
  phone          String?         @db.VarChar(40)
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model StockMovement {
  id                  Int                       @id @default(autoincrement())
  productId           Int
  product             Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind                StockMovementKind
  delta               Int
  quantityAfter       Int
  createdAt           DateTime                  @default(now())
  receiptItemId       Int?                      @unique
  receiptItem         RestockReceiptItem?       @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  customerOrderItemId Int?                      @unique
  customerOrderItem   CustomerOrderRequestItem? @relation(fields: [customerOrderItemId], references: [id], onDelete: Restrict)

  @@index([productId, id])
}

enum StockMovementKind {
  OPENING
  ADJUSTMENT
  RESTOCK
  ORDER_CONFIRMED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  version      Int                 @default(0)
  expectedDate DateTime?           @db.Date
  remarks      String?             @db.VarChar(1000)
  createdAt    DateTime            @default(now())
  sentAt       DateTime?
  receivedAt   DateTime?
  items        PurchaseOrderItem[]
  receipts     RestockReceipt[]
  notes        RestockNote[]
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  RECEIVED_WITH_ISSUES
}

model PurchaseOrderItem {
  id               Int                  @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  productId        Int
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderedQuantity  Int
  unitCost         Decimal              @db.Decimal(12, 2)
  receivedQuantity Int                  @default(0)
  damagedQuantity  Int                  @default(0)
  receiptItems     RestockReceiptItem[]

  @@unique([purchaseOrderId, productId])
}

model RestockReceipt {
  id              Int                  @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  requestId       String               @unique @db.VarChar(36)
  requestHash     String               @db.Char(64)
  createdAt       DateTime             @default(now())
  items           RestockReceiptItem[]
}

model RestockReceiptItem {
  id                  Int               @id @default(autoincrement())
  receiptId           Int
  receipt             RestockReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  goodQuantity        Int
  damagedQuantity     Int
  inspectionNote      String?           @db.VarChar(1000)
  movement            StockMovement?

  @@unique([receiptId, purchaseOrderItemId])
}

model RestockNote {
  id              Int             @id @default(autoincrement())
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  productId       Int?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            RestockNoteType
  quantity        Int
  details         String          @db.VarChar(1000)
  createdAt       DateTime        @default(now())
}

enum RestockNoteType {
  GENERAL
  MISSING
  DAMAGED
}

model CustomerOrderRequest {
  id                    Int                        @id @default(autoincrement())
  requestId             String                     @unique @db.VarChar(36)
  requestHash           String                     @db.Char(64)
  name                  String                     @db.VarChar(160)
  phone                 String                     @db.VarChar(40)
  note                  String?                    @db.VarChar(1000)
  createdAt             DateTime                   @default(now())
  reviewedAt            DateTime?
  confirmedAt           DateTime?
  completedAt           DateTime?
  deliveryAddress       String?                    @db.VarChar(500)
  deliveryFee           Decimal?                   @db.Decimal(12, 2)
  demoPayment           Boolean                    @default(false)
  paymentProof          Bytes?                     @db.MediumBlob
  paymentProofType      String?                    @db.VarChar(16)
  proofSubmittedAt      DateTime?
  proofNeedsReplacement Boolean                    @default(false)
  items                 CustomerOrderRequestItem[]
}

model CustomerOrderRequestItem {
  id             Int                  @id @default(autoincrement())
  orderRequestId Int
  orderRequest   CustomerOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Restrict)
  productId      Int
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String               @db.VarChar(64)
  name           String               @db.VarChar(160)
  price          Decimal              @db.Decimal(12, 2)
  quantity       Int
  movement       StockMovement?

  @@unique([orderRequestId, productId])
}
